<!-- ========================
     INFO PRÁCTICA
     ======================== -->
<section id="info">
  <div class="info-inner">
    <div class="info-header">
      <p class="section-label reveal" style="justify-content:center;">Desde Rosario</p>
      <h2 class="section-title reveal delay-1">Cómo llegar al<br><em>Norte Argentino</em></h2>
      <p class="section-body reveal delay-2" style="margin:0 auto; text-align:center;">
        Tres formas de llegar desde Rosario (Santa Fe) hasta Salta Capital y Tilcara.
      </p>
    </div>

    <div class="transport-grid">
      <!-- AVION -->
      <div class="transport-card reveal">
        <div class="transport-icon">✈️</div>
        <div class="transport-mode">Avión</div>
        <div class="transport-time">~2 horas de vuelo</div>
        <p class="transport-desc">La opción más rápida y cómoda. Aerolíneas Argentinas y Flybondi operan vuelos directos o con escala en Buenos Aires. Desde el Aeropuerto Islas Malvinas (ROS) al Martín Miguel de Güemes (SLA).</p>
        <div class="transport-price">Precio estimado I/V: <strong>$80.000 — $350.000 ARS</strong></div>
        <ul class="transport-pros">
          <li>Ideal para estadías cortas</li>
          <li>Múltiples frecuencias semanales</li>
          <li>Llegada directa a Salta Capital</li>
          <li>+2 hs. 30 min. en bus hasta Tilcara</li>
        </ul>
      </div>

      <!-- OMNIBUS -->
      <div class="transport-card reveal delay-1">
        <div class="transport-icon">🚌</div>
        <div class="transport-mode">Ómnibus</div>
        <div class="transport-time">14 a 18 horas</div>
        <p class="transport-desc">La Veloz del Norte, Andesmar y Flechabus operan servicios nocturnos y diurnos por RN 34. El viaje nocturno en cama suite permite aprovechar el día en destino.</p>
        <div class="transport-price">Por tramo: <strong>$28.000 — $80.000 ARS</strong></div>
        <ul class="transport-pros">
          <li>Opción más económica</li>
          <li>Cama suite y ejecutivo disponibles</li>
          <li>Salidas casi diarias en temporada alta</li>
          <li>Rosario–Tilcara: ~18–20 hs. totales</li>
        </ul>
      </div>

      <!-- AUTO -->
      <div class="transport-card reveal delay-2">
        <div class="transport-icon">🚗</div>
        <div class="transport-mode">Automóvil</div>
        <div class="transport-time">13 a 17 horas</div>
        <p class="transport-desc">Por autopista Rosario-Córdoba, luego RN 9 hasta Salta y continuación por la Quebrada. 1.390 km a Salta / 1.525 km a Tilcara. Ideal en dos etapas con parada en Tucumán.</p>
        <div class="transport-price">Combustible + peajes: <strong>$120.000+ ARS</strong></div>
        <ul class="transport-pros">
          <li>Máxima libertad de movimiento</li>
          <li>Ideal para grupos familiares</li>
          <li>Acceso a destinos fuera de circuitos</li>
          <li>No conducir de noche en serranías</li>
        </ul>
      </div>
    </div>

    <h3 class="section-title reveal" style="font-size:1.8rem; margin-bottom:2rem; text-align:center;">Resumen comparativo</h3>
    <div class="info-table-wrap reveal delay-1">
      <table class="info-table">
        <thead>
          <tr>
            <th>Medio</th>
            <th>Duración aprox.</th>
            <th>Costo estimado</th>
            <th>Ventaja principal</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>✈️ Avión</td>
            <td>~2 hs. (directo)</td>
            <td class="price-highlight">$80.000–350.000 ARS I/V</td>
            <td>Rapidez y comodidad</td>
          </tr>
          <tr>
            <td>🚌 Ómnibus</td>
            <td>14 a 18 hs.</td>
            <td class="price-highlight">$28.000–80.000 ARS por tramo</td>
            <td>Económico, cama suite</td>
          </tr>
          <tr>
            <td>🚗 Automóvil</td>
            <td>13 a 15 hs. (en etapas)</td>
            <td class="price-highlight">~$120.000+ ARS total</td>
            <td>Libertad total en destino</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Alojamiento info -->
    <div style="margin-top: 5rem;">
      <h3 class="section-title reveal" style="font-size:1.8rem; margin-bottom:2rem; text-align:center;">Planta <em>hotelera</em></h3>
      <div class="transport-grid">
        <div class="transport-card reveal">
          <div class="transport-icon">🏨</div>
          <div class="transport-mode">Salta Capital</div>
          <div class="transport-time">+250 establecimientos · 8.500 plazas</div>
          <ul class="transport-pros" style="margin-top:1rem;">
            <li>5 hoteles 5 estrellas (Sheraton, Alejandro I)</li>
            <li>18–22 hoteles 4 estrellas (NH, Hotel Salta)</li>
            <li>+30 hoteles boutique y posadas</li>
            <li>+40 hostels para mochileros</li>
            <li>+300 restaurantes habilitados</li>
          </ul>
        </div>
        <div class="transport-card reveal delay-1">
          <div class="transport-icon">🏡</div>
          <div class="transport-mode">Tilcara</div>
          <div class="transport-time">80–100 establecimientos · 2.500 plazas</div>
          <ul class="transport-pros" style="margin-top:1rem;">
            <li>5–8 hoteles boutique 4★ (Posada de Luz)</li>
            <li>15–20 posadas y hoteles 3★</li>
            <li>Cabañas de adobe con vistas a la Quebrada</li>
            <li>+25 hostels de calidad</li>
            <li>4–6 campings habilitados</li>
          </ul>
        </div>
        <div class="transport-card reveal delay-2">
          <div class="transport-icon">📅</div>
          <div class="transport-mode">Temporadas</div>
          <div class="transport-time">Temporada alta vs. baja</div>
          <ul class="transport-pros" style="margin-top:1rem;">
            <li>Alta: Julio–Agosto y Enero–Febrero</li>
            <li>Descuentos 30–40% en temporada baja</li>
            <li>Carnaval agota plazas en toda la Quebrada</li>
            <li>Tren a las Nubes: reservar 30–45 días antes</li>
            <li>Estadía media Salta: 3–5 noches</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

