          <div class="form-group">
            <label for="fecha-hasta">Fecha de salida</label>
            <input type="date" id="fecha-hasta" name="fecha-hasta">
          </div>
        </div>
        <div class="form-group">
          <label for="mensaje">Contanos qué buscás en tu viaje</label>
          <textarea id="mensaje" name="mensaje" placeholder="¿Cultura, aventura, gastronomía, relax? Cualquier detalle nos ayuda a armar la experiencia ideal..."></textarea>
        </div>
        <button type="button" class="form-submit" onclick="submitForm()">
          Enviar consulta →
        </button>
        <p class="form-aviso">Al enviar aceptás nuestra <a href="https://web-iat.vercel.app/#" onclick="return false;">Política de Privacidad</a>. No compartimos tus datos con terceros.</p>
