  <style>
    /* =============================
       CSS VARIABLES & RESET
       ============================= */
    :root {
      --ink:        #0e0907;
      --deep:       #1a100a;
      --terra:      #8b2e12;
      --ochre:      #c4762a;
      --gold:       #d4a853;
      --sand:       #e8d5b0;
      --cream:      #f5ede0;
      --salt:       #f8f5ef;
      --sky:        #6aa0c4;
      --sage:       #5a7a5e;
      --white:      #ffffff;
      --glass:      rgba(255,255,255,0.06);
      --glass-b:    rgba(255,255,255,0.12);
      --r: 0.75rem;
      --ease: cubic-bezier(0.23, 1, 0.32, 1);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      background: var(--ink);
      color: var(--cream);
      font-family: 'Crimson Pro', Georgia, serif;
      overflow-x: hidden;
      cursor: none;
    }

    /* =============================
       CUSTOM CURSOR
       ============================= */
    .cursor {
      position: fixed; top: 0; left: 0; width: 12px; height: 12px;
      background: var(--gold); border-radius: 50%; pointer-events: none;
      z-index: 9999; transform: translate(-50%,-50%);
      transition: width 0.3s var(--ease), height 0.3s var(--ease), background 0.3s;
      mix-blend-mode: difference;
    }
    .cursor-ring {
      position: fixed; top: 0; left: 0; width: 36px; height: 36px;
      border: 1.5px solid rgba(212,168,83,0.6); border-radius: 50%;
      pointer-events: none; z-index: 9998; transform: translate(-50%,-50%);
      transition: transform 0.12s var(--ease), width 0.3s, height 0.3s;
    }
    body:hover .cursor { opacity: 1; }
    a:hover ~ .cursor, button:hover ~ .cursor { width: 22px; height: 22px; }

    /* =============================
       SCROLLBAR
       ============================= */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--ink); }
    ::-webkit-scrollbar-thumb { background: var(--ochre); border-radius: 2px; }

    /* =============================
       PROGRESS BAR
       ============================= */
    #progress-bar {
      position: fixed; top: 0; left: 0; height: 3px; width: 0%;
      background: linear-gradient(90deg, var(--terra), var(--gold));
      z-index: 10000; transition: width 0.1s linear;
    }

    /* =============================
       NAV
       ============================= */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      padding: 1.4rem 3rem;
      display: flex; align-items: center; justify-content: space-between;
      transition: background 0.5s, padding 0.4s;
    }
    nav.scrolled {
      background: rgba(14,9,7,0.92);
      backdrop-filter: blur(18px);
      padding: 1rem 3rem;
      border-bottom: 1px solid rgba(196,118,42,0.2);
    }
    .nav-logo {
      font-family: 'Cinzel', serif;
      font-size: 1rem; letter-spacing: 0.35em; color: var(--gold);
      text-decoration: none; text-transform: uppercase;
    }
    .nav-links { display: flex; gap: 2.2rem; list-style: none; }
    .nav-links a {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.7rem; letter-spacing: 0.2em; color: var(--sand);
      text-decoration: none; text-transform: uppercase;
      transition: color 0.3s;
      position: relative;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -3px; left: 0;
      width: 0; height: 1px; background: var(--gold);
      transition: width 0.4s var(--ease);
    }
    .nav-links a:hover { color: var(--gold); }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase;
      background: var(--terra); color: var(--cream);
      border: 1px solid var(--terra); padding: 0.6rem 1.5rem;
      text-decoration: none; border-radius: 1px;
      transition: background 0.3s, color 0.3s;
    }
    .nav-cta:hover { background: transparent; color: var(--terra); }

    /* Mobile nav hamburger */
    .hamburger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 4px;
    }
    .hamburger span { display: block; width: 24px; height: 1.5px; background: var(--cream); transition: 0.3s; }
    .mobile-menu {
      display: none; position: fixed; inset: 0; background: rgba(14,9,7,0.97);
      z-index: 999; flex-direction: column; align-items: center; justify-content: center; gap: 2.5rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-family: 'Cinzel', serif; font-size: 1.4rem; color: var(--cream);
      text-decoration: none; letter-spacing: 0.15em;
      transition: color 0.3s;
    }
    .mobile-menu a:hover { color: var(--gold); }
    .mobile-close {
      position: absolute; top: 1.5rem; right: 2rem;
      background: none; border: none; color: var(--sand);
      font-size: 1.8rem; cursor: pointer;
    }

    /* =============================
       HERO
       ============================= */
    #hero {
      height: 100vh; min-height: 700px;
      position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(to bottom, rgba(14,9,7,0.2) 0%, rgba(14,9,7,0.65) 60%, rgba(14,9,7,1) 100%),
        url('https://lukaorellano-collab.github.io/WebIAT/img/primerfoto.webp');
      background-size: cover; background-position: center 30%;
      transform: scale(1.08);
      transition: transform 0.1s linear;
      will-change: transform;
    }
    .hero-content {
      position: relative; z-index: 2;
      text-align: center; padding: 0 1.5rem;
      display: flex; flex-direction: column; align-items: center;
    }
    .hero-tag {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.7rem; letter-spacing: 0.45em; color: var(--gold);
      text-transform: uppercase; margin-bottom: 1.8rem;
      opacity: 0; transform: translateY(20px);
      animation: fadeUp 1s 0.3s var(--ease) forwards;
      display: flex; align-items: center; gap: 1rem;
    }
    .hero-tag::before, .hero-tag::after {
      content: ''; display: block; width: 40px; height: 1px; background: var(--gold);
    }
    h1.hero-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(2.6rem, 8vw, 6.5rem);
      line-height: 1.05; font-weight: 700;
      color: var(--cream); margin-bottom: 1rem;
      opacity: 0; transform: translateY(30px);
      animation: fadeUp 1.1s 0.55s var(--ease) forwards;
      text-shadow: 0 4px 40px rgba(0,0,0,0.5);
    }
    h1.hero-title em { color: var(--gold); font-style: normal; }
    .hero-sub {
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      color: var(--sand); font-weight: 300; max-width: 600px;
      line-height: 1.7; margin-bottom: 2.8rem;
      opacity: 0; transform: translateY(30px);
      animation: fadeUp 1.1s 0.75s var(--ease) forwards;
      font-style: italic;
    }
    .hero-btns {
      display: flex; gap: 1.2rem; flex-wrap: wrap; justify-content: center;
      opacity: 0; transform: translateY(30px);
      animation: fadeUp 1s 1s var(--ease) forwards;
    }
    .btn-primary {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
      background: var(--terra); color: var(--cream);
      border: 1px solid var(--terra); padding: 1rem 2.5rem;
      text-decoration: none; border-radius: 1px;
      transition: all 0.4s var(--ease);
      position: relative; overflow: hidden;
    }
    .btn-primary::before {
      content: ''; position: absolute; inset: 0;
      background: var(--gold); transform: scaleX(0); transform-origin: left;
      transition: transform 0.4s var(--ease);
    }
    .btn-primary:hover::before { transform: scaleX(1); }
    .btn-primary span { position: relative; z-index: 1; }
    .btn-secondary {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
      background: transparent; color: var(--cream);
      border: 1px solid rgba(255,255,255,0.35); padding: 1rem 2.5rem;
      text-decoration: none; border-radius: 1px;
      transition: all 0.4s var(--ease);
    }
    .btn-secondary:hover {
      background: rgba(255,255,255,0.08); border-color: var(--cream);
    }
    .hero-scroll {
      position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
      opacity: 0; animation: fadeIn 1s 1.5s forwards;
    }
    .hero-scroll span {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.3em; color: var(--sand); text-transform: uppercase;
    }
    .scroll-line {
      width: 1px; height: 50px; background: linear-gradient(to bottom, var(--gold), transparent);
      animation: scrollPulse 1.8s infinite;
    }

    /* =============================
       SECTION COMMONS
       ============================= */
    section { position: relative; }
    .section-label {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.45em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 0.8rem;
      display: flex; align-items: center; gap: 0.8rem;
    }
    .section-label::before { content: ''; display: block; width: 30px; height: 1px; background: var(--ochre); }
    h2.section-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(2rem, 5vw, 3.8rem);
      line-height: 1.1; font-weight: 600;
      color: var(--cream); margin-bottom: 1.5rem;
    }
    h2.section-title em { color: var(--gold); font-style: normal; }
    .section-body {
      font-size: 1.15rem; line-height: 1.9; color: var(--sand);
      max-width: 680px; font-weight: 300;
    }
    .reveal {
      opacity: 0; transform: translateY(50px);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-left {
      opacity: 0; transform: translateX(-60px);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal-left.visible { opacity: 1; transform: translateX(0); }
    .reveal-right {
      opacity: 0; transform: translateX(60px);
      transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
    }
    .reveal-right.visible { opacity: 1; transform: translateX(0); }
    .delay-1 { transition-delay: 0.15s !important; }
    .delay-2 { transition-delay: 0.3s !important; }
    .delay-3 { transition-delay: 0.45s !important; }
    .delay-4 { transition-delay: 0.6s !important; }
    .delay-5 { transition-delay: 0.75s !important; }

    /* =============================
       INTRO / NOA
       ============================= */
    #intro {
      padding: 7rem 3rem;
      background: var(--ink);
      display: grid; grid-template-columns: 1fr 1fr; gap: 6rem;
      align-items: center; max-width: 1300px; margin: 0 auto;
    }
    .intro-stats {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
      margin-top: 3rem;
    }
    .stat-box {
      border: 1px solid rgba(196,118,42,0.25);
      padding: 1.5rem; border-radius: 2px;
      background: var(--glass);
      transition: border-color 0.3s, background 0.3s;
    }
    .stat-box:hover {
      border-color: var(--ochre); background: var(--glass-b);
    }
    .stat-number {
      font-family: 'Cinzel', serif; font-size: 2.2rem;
      color: var(--gold); line-height: 1;
    }
    .stat-label {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.2em; color: var(--sand);
      text-transform: uppercase; margin-top: 0.4rem;
    }
    .intro-img-wrap {
      position: relative; border-radius: 2px; overflow: hidden;
      height: 560px;
    }
    .intro-img-wrap img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.8s var(--ease);
      filter: brightness(0.85) saturate(1.1);
    }
    .intro-img-wrap:hover img { transform: scale(1.04); }
    .intro-img-caption {
      position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem;
      background: rgba(14,9,7,0.85); backdrop-filter: blur(8px);
      padding: 1rem 1.2rem; border-left: 2px solid var(--ochre);
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.2em; color: var(--sand); text-transform: uppercase;
    }

    /* =============================
       GEOGRAPHY STRIPE
       ============================= */
    #geo-stripe {
      background: linear-gradient(135deg, var(--terra) 0%, #6b1a08 100%);
      padding: 3rem;
      display: flex; align-items: center; justify-content: space-around;
      flex-wrap: wrap; gap: 2rem;
    }
    .geo-item {
      text-align: center;
      padding: 1rem 2rem;
    }
    .geo-icon { font-size: 2rem; margin-bottom: 0.5rem; }
    .geo-value {
      font-family: 'Cinzel', serif; font-size: 1.5rem; color: var(--cream);
    }
    .geo-desc {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.2em; color: rgba(245,237,224,0.7);
      text-transform: uppercase; margin-top: 0.3rem;
    }

    /* =============================
       DESTINATIONS — TWO BIG CARDS
       ============================= */
    #destinos {
      padding: 6rem 3rem; max-width: 1300px; margin: 0 auto;
    }
    .destinos-header { text-align: center; margin-bottom: 4rem; }
    .destinos-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    }
    .destino-card {
      position: relative; overflow: hidden; border-radius: 3px;
      height: 600px; cursor: pointer;
      transition: transform 0.4s var(--ease);
    }
    .destino-card:hover { transform: translateY(-6px); }
    .destino-card img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; transition: transform 0.8s var(--ease);
      filter: brightness(0.55);
    }
    .destino-card:hover img { transform: scale(1.07); }
    .destino-card-body {
      position: absolute; inset: 0; padding: 3rem;
      display: flex; flex-direction: column; justify-content: flex-end;
      background: linear-gradient(0deg, rgba(14,9,7,0.95) 0%, rgba(14,9,7,0.3) 50%, transparent 100%);
    }
    .destino-tag {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.35em; color: var(--gold);
      text-transform: uppercase; margin-bottom: 0.7rem;
    }
    .destino-name {
      font-family: 'Cinzel', serif; font-size: 2.4rem;
      color: var(--cream); line-height: 1.1; margin-bottom: 0.8rem;
    }
    .destino-desc {
      font-size: 1rem; color: var(--sand); line-height: 1.7;
      max-width: 380px; font-weight: 300; margin-bottom: 1.5rem;
    }
    .destino-facts {
      display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.8rem;
    }
    .destino-fact {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.15em; color: var(--sand);
      text-transform: uppercase;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .destino-fact::before {
      content: ''; display: block; width: 6px; height: 6px;
      border-radius: 50%; background: var(--ochre);
    }
    .btn-outline {
      display: inline-block; font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.28em; text-transform: uppercase;
      border: 1px solid rgba(255,255,255,0.45); color: var(--cream);
      padding: 0.7rem 1.6rem; text-decoration: none;
      transition: all 0.35s var(--ease);
      width: fit-content;
    }
    .btn-outline:hover {
      background: var(--ochre); border-color: var(--ochre);
    }
    .destino-alt { border: 1px solid rgba(196,118,42,0.3); background: rgba(14,9,7,0.6); }

    /* =============================
       DIVIDER
       ============================= */
    .divider {
      display: flex; align-items: center; gap: 2rem;
      padding: 2rem 3rem; max-width: 1300px; margin: 0 auto;
    }
    .divider-line { flex: 1; height: 1px; background: rgba(196,118,42,0.2); }
    .divider-icon { color: var(--ochre); font-size: 1.2rem; }

    /* =============================
       ATRACTIVOS
       ============================= */
    #atractivos {
      background: var(--deep);
      padding: 6rem 3rem;
    }
    .atractivos-inner { max-width: 1300px; margin: 0 auto; }
    .atractivos-header { margin-bottom: 4rem; }
    .atractivos-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    }
    .atractivo-card {
      position: relative; overflow: hidden; border-radius: 2px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(196,118,42,0.15);
      transition: border-color 0.4s, transform 0.4s var(--ease);
      group: true;
    }
    .atractivo-card:hover {
      border-color: var(--ochre); transform: translateY(-5px);
    }
    .atractivo-img {
      width: 100%; height: 260px; object-fit: cover;
      transition: transform 0.7s var(--ease), filter 0.5s;
      filter: brightness(0.75) saturate(1.1);
    }
    .atractivo-card:hover .atractivo-img { transform: scale(1.08); filter: brightness(0.85); }
    .atractivo-body { padding: 1.8rem; }
    .atractivo-type {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.3em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .atractivo-name {
      font-family: 'Cinzel', serif; font-size: 1.2rem;
      color: var(--cream); margin-bottom: 0.8rem; line-height: 1.3;
    }
    .atractivo-desc {
      font-size: 0.95rem; color: var(--sand); line-height: 1.7;
      font-weight: 300;
    }
    .atractivo-meta {
      margin-top: 1.2rem; padding-top: 1.2rem;
      border-top: 1px solid rgba(196,118,42,0.15);
      display: flex; align-items: center; justify-content: space-between;
    }
    .atractivo-loc {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.15em; color: var(--sand);
      text-transform: uppercase;
    }
    .atractivo-badge {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.58rem; letter-spacing: 0.1em;
      background: rgba(196,118,42,0.15); color: var(--ochre);
      padding: 0.25rem 0.7rem; border-radius: 20px;
      text-transform: uppercase;
    }
    /* Featured card (spans 2 cols) */
    .atractivo-card.featured { grid-column: span 2; }
    .atractivo-card.featured .atractivo-img { height: 360px; }

    /* =============================
       EXPERIENCIAS / TIPOS DE TURISMO
       ============================= */
    #experiencias {
      padding: 7rem 3rem;
      max-width: 1300px; margin: 0 auto;
    }
    .exp-header { margin-bottom: 4rem; text-align: center; }
    .exp-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;
    }
    .exp-card {
      position: relative; overflow: hidden; border-radius: 2px;
      height: 380px; cursor: pointer;
    }
    .exp-card img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; transition: transform 0.7s var(--ease);
      filter: brightness(0.45) saturate(1.2);
    }
    .exp-card:hover img { transform: scale(1.1); filter: brightness(0.6); }
    .exp-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(0deg, rgba(14,9,7,0.95) 0%, transparent 60%);
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 2rem 1.5rem;
    }
    .exp-icon { font-size: 2.2rem; margin-bottom: 0.7rem; }
    .exp-name {
      font-family: 'Cinzel', serif; font-size: 1.25rem;
      color: var(--cream); margin-bottom: 0.5rem;
    }
    .exp-desc {
      font-size: 0.9rem; color: var(--sand); line-height: 1.6;
      font-weight: 300; max-height: 0; overflow: hidden;
      transition: max-height 0.5s var(--ease), opacity 0.5s;
      opacity: 0;
    }
    .exp-card:hover .exp-desc { max-height: 120px; opacity: 1; }
    .exp-tags {
      display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.8rem;
    }
    .exp-tag {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.58rem; letter-spacing: 0.12em;
      background: rgba(196,118,42,0.2); color: var(--gold);
      padding: 0.2rem 0.6rem; border-radius: 20px; text-transform: uppercase;
    }

    /* =============================
       EXCURSIONES / TIMELINE
       ============================= */
    #excursiones {
      background: var(--deep); padding: 7rem 3rem;
    }
    .exc-inner { max-width: 1200px; margin: 0 auto; }
    .exc-header { margin-bottom: 5rem; text-align: center; }
    .exc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; }
    .exc-item { position: relative; }
    .exc-item-tag {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.35em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .exc-item-title {
      font-family: 'Cinzel', serif; font-size: 1.6rem;
      color: var(--cream); margin-bottom: 1rem;
    }
    .exc-item-meta {
      display: flex; gap: 2rem; margin-bottom: 1.5rem; flex-wrap: wrap;
    }
    .exc-meta-chip {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.15em; color: var(--sand);
      text-transform: uppercase;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .exc-meta-chip strong { color: var(--gold); }
    .exc-timeline { position: relative; padding-left: 1.5rem; }
    .exc-timeline::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0;
      width: 1px; background: rgba(196,118,42,0.3);
    }
    .timeline-step {
      position: relative; padding: 0 0 2rem 2rem;
    }
    .timeline-step::before {
      content: ''; position: absolute; left: -0.5rem; top: 0.3rem;
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--ochre); border: 2px solid var(--deep);
    }
    .timeline-time {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.2em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 0.3rem;
    }
    .timeline-text {
      font-size: 0.95rem; color: var(--sand); line-height: 1.7; font-weight: 300;
    }
    .exc-price {
      margin-top: 1.5rem; padding: 1.2rem 1.5rem;
      background: rgba(196,118,42,0.1); border: 1px solid rgba(196,118,42,0.3);
      border-radius: 2px;
    }
    .exc-price-label {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.2em; color: var(--sand); text-transform: uppercase;
    }
    .exc-price-value {
      font-family: 'Cinzel', serif; font-size: 1.3rem; color: var(--gold);
      margin-top: 0.3rem;
    }
    .exc-img {
      width: 100%; height: 240px; object-fit: cover;
      border-radius: 2px; margin-bottom: 1.5rem;
      filter: brightness(0.75); transition: filter 0.4s;
    }
    .exc-item:hover .exc-img { filter: brightness(0.9); }

    /* =============================
       EVENTOS
       ============================= */
    #eventos { padding: 7rem 3rem; max-width: 1300px; margin: 0 auto; }
    .eventos-header { margin-bottom: 4rem; }
    .eventos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .evento-card {
      position: relative; overflow: hidden; border-radius: 2px;
      border: 1px solid rgba(196,118,42,0.2);
      transition: border-color 0.4s, transform 0.4s;
    }
    .evento-card:hover { border-color: var(--gold); transform: translateY(-4px); }
    .evento-img {
      width: 100%; height: 220px; object-fit: cover;
      filter: brightness(0.65) saturate(1.2);
      transition: transform 0.6s var(--ease), filter 0.4s;
    }
    .evento-card:hover .evento-img { transform: scale(1.06); filter: brightness(0.8); }
    .evento-body { padding: 1.8rem; }
    .evento-mes {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.35em; color: var(--gold);
      text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .evento-name {
      font-family: 'Cinzel', serif; font-size: 1.15rem;
      color: var(--cream); margin-bottom: 0.8rem;
    }
    .evento-desc {
      font-size: 0.92rem; color: var(--sand); line-height: 1.7; font-weight: 300;
    }
    .evento-badge {
      display: inline-block; margin-top: 1rem;
      font-family: 'Josefin Sans', sans-serif; font-size: 0.58rem;
      letter-spacing: 0.15em; text-transform: uppercase;
      background: rgba(139,46,18,0.3); color: var(--terra);
      padding: 0.3rem 0.8rem; border-radius: 20px;
      border: 1px solid rgba(139,46,18,0.4);
    }

    /* =============================
       INFO PRÁCTICA / TRANSPORT
       ============================= */
    #info {
      background: linear-gradient(170deg, var(--deep) 0%, #0a0503 100%);
      padding: 7rem 3rem;
    }
    .info-inner { max-width: 1200px; margin: 0 auto; }
    .info-header { margin-bottom: 4rem; text-align: center; }
    .transport-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 4rem;
    }
    .transport-card {
      background: var(--glass);
      border: 1px solid rgba(196,118,42,0.2); border-radius: 3px;
      padding: 2.5rem 2rem;
      transition: border-color 0.4s, background 0.4s;
    }
    .transport-card:hover {
      border-color: var(--ochre); background: var(--glass-b);
    }
    .transport-icon { font-size: 2.5rem; margin-bottom: 1.2rem; }
    .transport-mode {
      font-family: 'Cinzel', serif; font-size: 1.3rem;
      color: var(--cream); margin-bottom: 0.5rem;
    }
    .transport-time {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.25em; color: var(--gold);
      text-transform: uppercase; margin-bottom: 1rem;
    }
    .transport-desc {
      font-size: 0.95rem; color: var(--sand); line-height: 1.7; font-weight: 300;
      margin-bottom: 1.5rem;
    }
    .transport-price {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.15em; color: var(--sand);
      text-transform: uppercase;
    }
    .transport-price strong { color: var(--gold); font-size: 0.85rem; }
    .transport-pros {
      list-style: none; margin-top: 1rem;
    }
    .transport-pros li {
      font-size: 0.88rem; color: var(--sand); padding: 0.3rem 0;
      padding-left: 1.2rem; position: relative;
    }
    .transport-pros li::before {
      content: '→'; position: absolute; left: 0; color: var(--ochre);
    }
    .info-table-wrap {
      overflow-x: auto; border-radius: 2px;
      border: 1px solid rgba(196,118,42,0.2);
    }
    table.info-table {
      width: 100%; border-collapse: collapse;
      font-size: 0.95rem;
    }
    .info-table thead {
      background: rgba(139,46,18,0.3);
    }
    .info-table th {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--sand); padding: 1rem 1.5rem; text-align: left;
      border-bottom: 1px solid rgba(196,118,42,0.3);
    }
    .info-table td {
      padding: 0.9rem 1.5rem; color: var(--sand);
      border-bottom: 1px solid rgba(196,118,42,0.1);
    }
    .info-table tr:last-child td { border-bottom: none; }
    .info-table tr:hover td { background: rgba(196,118,42,0.05); }
    .info-table td:first-child {
      font-family: 'Josefin Sans', sans-serif;
      color: var(--cream); font-size: 0.85rem; letter-spacing: 0.05em;
    }
    .price-highlight { color: var(--gold); font-family: 'Cinzel', serif; }

    /* =============================
       QUOTE BANNER
       ============================= */
    #quote-banner {
      min-height: 500px; position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .quote-bg {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(14,9,7,0.7), rgba(14,9,7,0.7)),
        url('https://lukaorellano-collab.github.io/WebIAT/img/trennubes.webp');
      background-size: cover; background-position: center;
      background-attachment: fixed;
    }
    .quote-content {
      position: relative; z-index: 2; text-align: center;
      max-width: 900px; padding: 4rem 3rem;
    }
    .big-quote {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(1.5rem, 4vw, 3rem);
      color: var(--cream); line-height: 1.4;
      margin-bottom: 1.5rem;
    }
    .big-quote em { color: var(--gold); font-style: normal; }
    .quote-source {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.7rem; letter-spacing: 0.35em; color: var(--sand);
      text-transform: uppercase;
    }

    /* =============================
       CTA FINAL
       ============================= */
    #cta {
      padding: 8rem 3rem; text-align: center;
      background: linear-gradient(170deg, #0f0704 0%, var(--ink) 100%);
      position: relative; overflow: hidden;
    }
    #cta::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at center, rgba(196,118,42,0.08) 0%, transparent 70%);
    }
    .cta-label {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.68rem; letter-spacing: 0.5em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 1.5rem;
    }
    .cta-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(2rem, 6vw, 4.5rem);
      color: var(--cream); margin-bottom: 1.5rem; line-height: 1.15;
    }
    .cta-title em { color: var(--gold); font-style: normal; }
    .cta-body {
      font-size: 1.1rem; color: var(--sand); max-width: 540px;
      margin: 0 auto 3rem; line-height: 1.8; font-weight: 300; font-style: italic;
    }
    .cta-btns {
      display: flex; gap: 1.2rem; justify-content: center; flex-wrap: wrap;
    }
    .btn-gold {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
      background: var(--gold); color: var(--ink);
      border: none; padding: 1.1rem 2.8rem;
      cursor: pointer; border-radius: 1px;
      transition: all 0.4s var(--ease);
      position: relative; overflow: hidden;
    }
    .btn-gold:hover { background: var(--ochre); letter-spacing: 0.4em; }
    .cta-ornament {
      position: absolute; bottom: 3rem; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 2rem;
    }
    .ornament-line { width: 80px; height: 1px; background: rgba(196,118,42,0.3); }
    .ornament-diamond {
      width: 8px; height: 8px; background: var(--ochre);
      transform: rotate(45deg);
    }

    /* =============================
       FOOTER
       ============================= */
    footer {
      background: #080503; border-top: 1px solid rgba(196,118,42,0.15);
      padding: 3rem; text-align: center;
    }
    .footer-logo {
      font-family: 'Cinzel', serif;
      font-size: 1.2rem; color: var(--gold); letter-spacing: 0.3em;
      margin-bottom: 0.8rem;
    }
    .footer-tagline {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.3em; color: var(--sand);
      text-transform: uppercase; margin-bottom: 1.5rem;
    }
    .footer-links {
      display: flex; gap: 2rem; justify-content: center;
      list-style: none; flex-wrap: wrap; margin-bottom: 2rem;
    }
    .footer-links a {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.2em; color: var(--sand);
      text-decoration: none; text-transform: uppercase;
      transition: color 0.3s;
    }
    .footer-links a:hover { color: var(--gold); }
    .footer-copy {
      font-size: 0.8rem; color: rgba(232,213,176,0.35);
    }

    /* =============================
       PARALLAX SECTION
       ============================= */
    .parallax-section {
      min-height: 350px; position: relative; overflow: hidden;
      display: flex; align-items: center;
    }
    .parallax-bg {
      position: absolute; inset: -20%; width: 100%; height: 140%;
      background-size: cover; background-position: center;
      background-attachment: fixed;
    }
    .parallax-overlay {
      position: absolute; inset: 0;
      background: rgba(14,9,7,0.6);
    }
    .parallax-text {
      position: relative; z-index: 2;
      padding: 3rem; max-width: 800px;
    }

    /* =============================
       TOAST NOTIFICATION
       ============================= */
    .toast {
      position: fixed; bottom: 2rem; right: 2rem; z-index: 9000;
      background: rgba(20,12,8,0.95); border: 1px solid var(--ochre);
      padding: 1rem 1.5rem; border-radius: 3px;
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.7rem; letter-spacing: 0.15em; color: var(--gold);
      text-transform: uppercase; backdrop-filter: blur(10px);
      transform: translateY(100px); opacity: 0;
      transition: transform 0.5s var(--ease), opacity 0.5s;
    }
    .toast.show { transform: translateY(0); opacity: 1; }

    /* =============================
       ANIMATIONS
       ============================= */
    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      to { opacity: 1; }
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }
    @keyframes spin-slow {
      to { transform: rotate(360deg); }
    }

    /* Ornamental spinner */
    .ornament-spin {
      width: 80px; height: 80px; margin: 2rem auto;
      border: 1px solid rgba(196,118,42,0.4); border-radius: 50%;
      position: relative;
    }
    .ornament-spin::before, .ornament-spin::after {
      content: ''; position: absolute;
    }
    .ornament-spin::before {
      inset: 6px; border: 1px solid rgba(196,118,42,0.25); border-radius: 50%;
    }
    .ornament-spin::after {
      top: 50%; left: 50%; width: 8px; height: 8px;
      background: var(--ochre); border-radius: 50%;
      transform: translate(-50%, -50%);
    }

    /* =============================
       RESPONSIVE
       ============================= */
    @media (max-width: 1100px) {
      #intro { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2rem; }
      .intro-img-wrap { height: 380px; }
      .atractivos-grid { grid-template-columns: repeat(2, 1fr); }
      .atractivo-card.featured { grid-column: span 1; }
      .atractivo-card.featured .atractivo-img { height: 260px; }
      .exp-grid { grid-template-columns: repeat(2, 1fr); }
      .transport-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 800px) {
      nav { padding: 1.2rem 1.5rem; }
      .nav-links, .nav-cta { display: none; }
      .hamburger { display: flex; }
      #destinos { padding: 4rem 1.5rem; }
      .destinos-grid { grid-template-columns: 1fr; }
      .destino-card { height: 480px; }
      .atractivos-grid { grid-template-columns: 1fr; }
      .exp-grid { grid-template-columns: 1fr 1fr; }
      .exc-grid { grid-template-columns: 1fr; gap: 3rem; }
      .eventos-grid { grid-template-columns: 1fr; }
      .transport-grid { grid-template-columns: 1fr; }
      #geo-stripe { flex-direction: column; text-align: center; }
      .divider { padding: 1.5rem; }
      #info, #excursiones, #experiencias, #eventos, #atractivos { padding: 4rem 1.5rem; }
      .quote-bg { background-attachment: scroll; }
    }
    @media (max-width: 500px) {
      .exp-grid { grid-template-columns: 1fr; }
      h1.hero-title { font-size: 2.2rem; }
      .hero-btns { flex-direction: column; align-items: center; }
      nav { padding: 1rem; }
    }

    /* =============================
       SKIP NAVIGATION (accesibilidad)
       ============================= */
    .skip-nav {
      position: absolute; top: -100px; left: 1rem; z-index: 99999;
      background: var(--gold); color: var(--ink);
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.8rem; letter-spacing: 0.1em;
      padding: 0.8rem 1.5rem; border-radius: 2px;
      text-decoration: none; font-weight: 600;
      transition: top 0.2s;
    }
    .skip-nav:focus { top: 1rem; }

    /* =============================
       TESTIMONIALS
       ============================= */
    #testimonios {
      padding: 7rem 3rem; background: var(--ink);
      position: relative; overflow: hidden;
    }
    #testimonios::before {
      content: '❝';
      position: absolute; top: 3rem; left: 3rem;
      font-size: 15rem; color: rgba(196,118,42,0.05);
      font-family: Georgia, serif; line-height: 1;
      pointer-events: none;
    }
    .testimonios-inner { max-width: 1200px; margin: 0 auto; }
    .testimonios-header { text-align: center; margin-bottom: 4rem; }
    .testimonios-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    }
    .testimonio-card {
      background: var(--glass);
      border: 1px solid rgba(196,118,42,0.2); border-radius: 3px;
      padding: 2.2rem;
      transition: border-color 0.4s, background 0.4s, transform 0.4s;
    }
    .testimonio-card:hover {
      border-color: var(--ochre); background: var(--glass-b);
      transform: translateY(-4px);
    }
    .testimonio-stars {
      color: var(--gold); font-size: 1rem; margin-bottom: 1rem;
      letter-spacing: 0.1em;
    }
    .testimonio-texto {
      font-size: 1rem; color: var(--sand); line-height: 1.8;
      font-style: italic; font-weight: 300; margin-bottom: 1.5rem;
    }
    .testimonio-autor {
      display: flex; align-items: center; gap: 1rem;
    }
    .testimonio-avatar {
      width: 40px; height: 40px; border-radius: 50%;
      background: linear-gradient(135deg, var(--terra), var(--ochre));
      display: flex; align-items: center; justify-content: center;
      font-family: 'Cinzel', serif; font-size: 0.9rem;
      color: var(--cream); flex-shrink: 0;
    }
    .testimonio-nombre {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.15em;
      color: var(--cream); text-transform: uppercase;
    }
    .testimonio-origen {
      font-size: 0.8rem; color: var(--sand); opacity: 0.7;
    }
    .testimonio-plataforma {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.58rem; letter-spacing: 0.12em;
      background: rgba(196,118,42,0.15); color: var(--gold);
      padding: 0.2rem 0.6rem; border-radius: 20px; text-transform: uppercase;
      display: inline-block; margin-top: 0.5rem;
    }
    @media (max-width: 900px) { .testimonios-grid { grid-template-columns: 1fr; } }
    @media (max-width: 1100px) { .testimonios-grid { grid-template-columns: 1fr 1fr; } }

    /* =============================
       CONTACT FORM
       ============================= */
    #contacto {
      padding: 7rem 3rem;
      background: linear-gradient(170deg, var(--deep) 0%, var(--ink) 100%);
    }
    .contacto-inner {
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr 1.2fr; gap: 5rem; align-items: start;
    }
    .contacto-info { }
    .contacto-dato {
      display: flex; align-items: flex-start; gap: 1rem;
      margin-bottom: 1.8rem;
    }
    .contacto-dato-icon {
      font-size: 1.4rem; flex-shrink: 0; margin-top: 0.1rem;
    }
    .contacto-dato-label {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.25em; color: var(--ochre);
      text-transform: uppercase; margin-bottom: 0.3rem;
    }
    .contacto-dato-value {
      font-size: 1rem; color: var(--sand); font-weight: 300;
    }
    .contacto-dato-value a {
      color: var(--sand); text-decoration: none;
      transition: color 0.3s;
    }
    .contacto-dato-value a:hover { color: var(--gold); }
    .contacto-social {
      display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap;
    }
    .social-btn {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
      background: var(--glass); color: var(--sand);
      border: 1px solid rgba(196,118,42,0.25); padding: 0.6rem 1.2rem;
      text-decoration: none; border-radius: 2px;
      transition: all 0.3s;
    }
    .social-btn:hover { background: var(--glass-b); border-color: var(--gold); color: var(--gold); }
    .whatsapp-btn {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
      background: #25D366; color: #fff;
      padding: 0.9rem 1.8rem; border-radius: 2px;
      text-decoration: none; margin-top: 1.5rem;
      transition: background 0.3s, transform 0.3s;
    }
    .whatsapp-btn:hover { background: #1da851; transform: translateY(-2px); }
    /* Form */
    .contacto-form-wrap {
      background: var(--glass);
      border: 1px solid rgba(196,118,42,0.2); border-radius: 3px;
      padding: 2.5rem;
    }
    .form-title {
      font-family: 'Cinzel', serif; font-size: 1.3rem;
      color: var(--cream); margin-bottom: 0.5rem;
    }
    .form-subtitle {
      font-size: 0.9rem; color: var(--sand); margin-bottom: 2rem; font-weight: 300;
    }
    .form-group { margin-bottom: 1.4rem; }
    .form-group label {
      display: block;
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.2em; color: var(--sand);
      text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(196,118,42,0.25);
      border-radius: 2px; padding: 0.85rem 1rem;
      color: var(--cream); font-family: 'Crimson Pro', Georgia, serif;
      font-size: 1rem; outline: none;
      transition: border-color 0.3s, background 0.3s;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--ochre);
      background: rgba(196,118,42,0.06);
    }
    .form-group select option { background: var(--deep); }
    .form-group textarea { resize: vertical; min-height: 110px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-submit {
      width: 100%;
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
      background: var(--terra); color: var(--cream);
      border: none; padding: 1rem 2rem;
      cursor: pointer; border-radius: 1px;
      transition: background 0.3s, letter-spacing 0.3s;
      margin-top: 0.5rem;
    }
    .form-submit:hover { background: var(--ochre); letter-spacing: 0.4em; }
    .form-aviso {
      font-size: 0.78rem; color: rgba(232,213,176,0.5);
      margin-top: 0.8rem; line-height: 1.5;
    }
    .form-aviso a { color: var(--ochre); text-decoration: underline; }
    @media (max-width: 900px) {
      .contacto-inner { grid-template-columns: 1fr; gap: 3rem; }
    }
    @media (max-width: 600px) {
      .form-row { grid-template-columns: 1fr; }
      #contacto { padding: 4rem 1.5rem; }
    }

    /* =============================
       IMPROVED FOOTER
       ============================= */
    .footer-contact-row {
      display: flex; gap: 3rem; justify-content: center; flex-wrap: wrap;
      margin-bottom: 2rem; padding-bottom: 2rem;
      border-bottom: 1px solid rgba(196,118,42,0.1);
    }
    .footer-contact-item {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.62rem; letter-spacing: 0.18em;
      color: rgba(232,213,176,0.6); text-transform: uppercase;
    }
    .footer-contact-item a { color: var(--sand); text-decoration: none; transition: color 0.3s; }
    .footer-contact-item a:hover { color: var(--gold); }
    .footer-social-row {
      display: flex; gap: 1.2rem; justify-content: center; margin-bottom: 2rem;
    }
    .footer-social-link {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(232,213,176,0.5); text-decoration: none;
      padding: 0.4rem 0.9rem; border: 1px solid rgba(196,118,42,0.15);
      border-radius: 20px; transition: all 0.3s;
    }
    .footer-social-link:hover { color: var(--gold); border-color: var(--gold); }
    .footer-legal {
      display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;
      margin-top: 1.5rem; padding-top: 1.5rem;
      border-top: 1px solid rgba(196,118,42,0.08);
    }
    .footer-legal a {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.58rem; letter-spacing: 0.15em; text-transform: uppercase;
      color: rgba(232,213,176,0.35); text-decoration: underline;
      transition: color 0.3s;
    }
    .footer-legal a:hover { color: var(--sand); }

    /* =============================
       FORM SUCCESS MESSAGE
       ============================= */
    .form-success {
      display: none; text-align: center; padding: 2rem;
    }
    .form-success.show { display: block; }
    .form-success-icon { font-size: 3rem; margin-bottom: 1rem; }
    .form-success-text {
      font-family: 'Cinzel', serif; font-size: 1.2rem;
      color: var(--gold); margin-bottom: 0.8rem;
    }
    .form-success-sub { font-size: 0.95rem; color: var(--sand); }

    /* =============================
       LANGUAGE SWITCHER
       ============================= */
    .lang-switcher {
      position: relative; display: flex; align-items: center; margin-left: 1rem;
    }
    .lang-current {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--sand); background: none; border: 1px solid rgba(196,118,42,0.35);
      padding: 0.4rem 0.9rem; cursor: pointer; border-radius: 2px;
      display: flex; align-items: center; gap: 0.5rem;
      transition: border-color 0.3s, color 0.3s;
    }
    .lang-current:hover { border-color: var(--gold); color: var(--gold); }
    .lang-current .lang-arrow {
      font-size: 0.5rem; transition: transform 0.3s; display: inline-block;
    }
    .lang-switcher.open .lang-arrow { transform: rotate(180deg); }
    .lang-dropdown {
      position: absolute; top: calc(100% + 8px); right: 0;
      background: rgba(14,9,7,0.97); border: 1px solid rgba(196,118,42,0.3);
      border-radius: 3px; overflow: hidden;
      min-width: 120px; z-index: 2000;
      opacity: 0; transform: translateY(-8px); pointer-events: none;
      transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
      backdrop-filter: blur(20px);
    }
    .lang-switcher.open .lang-dropdown { opacity: 1; transform: translateY(0); pointer-events: all; }
    .lang-option {
      display: flex; align-items: center; gap: 0.7rem;
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--sand); padding: 0.75rem 1.2rem;
      cursor: pointer; transition: background 0.2s, color 0.2s;
      border: none; background: none; width: 100%; text-align: left;
    }
    .lang-option:hover { background: rgba(196,118,42,0.12); color: var(--gold); }
    .lang-option.active { color: var(--gold); }
    .lang-option .lang-flag { font-size: 1rem; }
    /* Hide lang switcher on mobile in nav, show in mobile menu */
    @media (max-width: 800px) {
      .lang-switcher { display: none; }
      .mobile-lang { display: flex !important; }
    }
    .mobile-lang {
      display: none; flex-direction: row; gap: 0.8rem;
      margin-top: 1rem; justify-content: center;
    }
    .mobile-lang-btn {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase;
      background: none; border: 1px solid rgba(196,118,42,0.3);
      color: var(--sand); padding: 0.5rem 1rem; border-radius: 2px;
      cursor: pointer; transition: all 0.3s;
    }
    .mobile-lang-btn.active, .mobile-lang-btn:hover {
      border-color: var(--gold); color: var(--gold);
    }

    /* =============================
       GOOGLE MAPS SECTION
       ============================= */
    #mapa {
      padding: 7rem 3rem;
      background: var(--deep);
    }
    .mapa-inner { max-width: 1200px; margin: 0 auto; }
    .mapa-header { text-align: center; margin-bottom: 3.5rem; }
    .mapa-layout {
      display: grid; grid-template-columns: 1fr 2fr; gap: 2.5rem; align-items: start;
    }
    .mapa-info-list { display: flex; flex-direction: column; gap: 1rem; }
    .mapa-punto {
      background: var(--glass);
      border: 1px solid rgba(196,118,42,0.2); border-radius: 3px;
      padding: 1.4rem 1.6rem;
      cursor: pointer;
      transition: border-color 0.3s, background 0.3s;
    }
    .mapa-punto:hover, .mapa-punto.active {
      border-color: var(--ochre); background: var(--glass-b);
    }
    .mapa-punto-nombre {
      font-family: 'Cinzel', serif; font-size: 1rem;
      color: var(--cream); margin-bottom: 0.3rem;
    }
    .mapa-punto-desc {
      font-size: 0.85rem; color: var(--sand); line-height: 1.6; font-weight: 300;
    }
    .mapa-punto-coords {
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.58rem; letter-spacing: 0.15em; color: var(--ochre);
      text-transform: uppercase; margin-top: 0.5rem;
    }
    .mapa-embed-wrap {
      border-radius: 4px; overflow: hidden;
      border: 1px solid rgba(196,118,42,0.2);
      position: relative;
    }
    .mapa-embed-wrap iframe {
      width: 100%; height: 480px; display: block;
      border: none; filter: saturate(0.9) contrast(1.05);
    }
    .mapa-caption {
      padding: 1rem 1.5rem;
      background: rgba(14,9,7,0.7);
      font-family: 'Josefin Sans', sans-serif;
      font-size: 0.6rem; letter-spacing: 0.2em; color: var(--sand);
      text-transform: uppercase; display: flex; align-items: center; gap: 0.6rem;
    }
    .mapa-caption::before { content: '📍'; }
    @media (max-width: 900px) {
      .mapa-layout { grid-template-columns: 1fr; }
      .mapa-embed-wrap iframe { height: 340px; }
      #mapa { padding: 4rem 1.5rem; }
    }
  </style>
</head>
<body>

<!-- Skip Navigation (accesibilidad WCAG) -->
<a href="https://web-iat.vercel.app/#main-content" class="skip-nav">Ir al contenido principal</a>

<!-- Cursor -->
<div class="cursor" id="cursor" style="left: 1435px; top: 29px; width: 12px; height: 12px;"></div>
<div class="cursor-ring" id="cursor-ring" style="left: 1435px; top: 29px; width: 36px; height: 36px;"></div>

<!-- Progress Bar -->
<div id="progress-bar"></div>

<!-- Toast -->
<div class="toast" id="toast">✦ Scroll para descubrir el Norte Argentino</div>

<!-- Navigation -->
<nav id="main-nav" role="navigation" aria-label="Menú principal">
  <a href="https://web-iat.vercel.app/#" class="nav-logo" aria-label="NOA Argentina - Inicio">NOA ✦ Argentina</a>
  <ul class="nav-links" role="list">
    <li><a href="https://web-iat.vercel.app/#destinos">Destinos</a></li>
    <li><a href="https://web-iat.vercel.app/#atractivos">Atractivos</a></li>
    <li><a href="https://web-iat.vercel.app/#excursiones">Excursiones</a></li>
    <li><a href="https://web-iat.vercel.app/#eventos">Eventos</a></li>
    <li><a href="https://web-iat.vercel.app/#info">Planificar</a></li>
    <li><a href="https://web-iat.vercel.app/#contacto">Contacto</a></li>
  </ul>
  <a href="https://web-iat.vercel.app/#contacto" class="nav-cta" data-i18n="nav.cta">Reservar viaje</a>
  <div class="lang-switcher" id="lang-switcher">
    <button class="lang-current" id="lang-current-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Cambiar idioma">
      <span id="lang-current-label">🇦🇷 ES</span>
      <span class="lang-arrow">▼</span>
    </button>
    <div class="lang-dropdown" role="listbox" aria-label="Seleccionar idioma">
      <button class="lang-option active" onclick="setLang(&#39;es&#39;)" data-lang="es" role="option" aria-selected="true">
        <span class="lang-flag">🇦🇷</span> Español
      </button>
      <button class="lang-option" onclick="setLang(&#39;en&#39;)" data-lang="en" role="option" aria-selected="false">
        <span class="lang-flag">🇺🇸</span> English
      </button>
      <button class="lang-option" onclick="setLang(&#39;pt&#39;)" data-lang="pt" role="option" aria-selected="false">
        <span class="lang-flag">🇧🇷</span> Português
      </button>
    </div>
  </div>
  <button class="hamburger" id="hamburger" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Menú móvil" aria-modal="true">
  <button class="mobile-close" id="mobile-close" aria-label="Cerrar menú">✕</button>
  <a href="https://web-iat.vercel.app/#destinos" class="mobile-link">Destinos</a>
  <a href="https://web-iat.vercel.app/#atractivos" class="mobile-link">Atractivos</a>
  <a href="https://web-iat.vercel.app/#excursiones" class="mobile-link">Excursiones</a>
  <a href="https://web-iat.vercel.app/#eventos" class="mobile-link">Eventos</a>
  <a href="https://web-iat.vercel.app/#info" class="mobile-link">Información</a>
  <a href="https://web-iat.vercel.app/#contacto" class="mobile-link">Contacto</a>
  <a href="https://web-iat.vercel.app/#contacto" class="mobile-link">Planificar viaje →</a>
  <div class="mobile-lang">
    <button class="mobile-lang-btn active" onclick="setLang(&#39;es&#39;);document.getElementById(&#39;mobile-menu&#39;).classList.remove(&#39;open&#39;)">🇦🇷 ES</button>
    <button class="mobile-lang-btn" onclick="setLang(&#39;en&#39;);document.getElementById(&#39;mobile-menu&#39;).classList.remove(&#39;open&#39;)">🇺🇸 EN</button>
    <button class="mobile-lang-btn" onclick="setLang(&#39;pt&#39;);document.getElementById(&#39;mobile-menu&#39;).classList.remove(&#39;open&#39;)">🇧🇷 PT</button>
  </div>
</div>

<!-- ========================
     HERO
     ======================== -->
<main id="main-content">
<section id="hero" aria-label="Bienvenida al Norte Argentino">
  <div class="hero-bg" id="hero-bg" role="img" aria-label="Vista panorámica del Noroeste Argentino, paisajes andinos"></div>
  <div class="hero-content">
    <div class="hero-tag" data-i18n="hero.tag">Noroeste Argentino</div>
    <h1 class="hero-title" data-i18n="hero.title">Descubrí el<br><em>Norte</em> Argentino</h1>
    <p class="hero-sub" data-i18n="hero.sub">Desde las selvas de las Yungas hasta los salares de la Puna.<br>Salta &amp; Tilcara te esperan con su rica cultura andina.</p>
    <div class="hero-btns">
      <a href="https://web-iat.vercel.app/#destinos" class="btn-primary"><span data-i18n="hero.btn1">Explorar destinos</span></a>
      <a href="https://web-iat.vercel.app/#contacto" class="btn-secondary" data-i18n="hero.btn2">Planificá tu viaje</a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span>Descubrí</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- ========================
     GEO STRIPE
     ======================== -->
<div id="geo-stripe">
  <div class="geo-item reveal">
    <div class="geo-icon">🏔️</div>
    <div class="geo-value">4.220 m</div>
    <div class="geo-desc">Altitud máxima</div>
  </div>
  <div class="geo-item reveal delay-1">
    <div class="geo-icon">👥</div>
    <div class="geo-value">+600 mil.</div>
    <div class="geo-desc">Visitantes por año</div>
  </div>
  <div class="geo-item reveal delay-2">
    <div class="geo-icon">🏛️</div>
    <div class="geo-value">UNESCO</div>
    <div class="geo-desc">Patrimonio Mundial</div>
  </div>
  <div class="geo-item reveal delay-3">
    <div class="geo-icon">🌄</div>
    <div class="geo-value">6 Provincias</div>
    <div class="geo-desc">Región NOA</div>
  </div>
  <div class="geo-item reveal delay-4">
    <div class="geo-icon">🦙</div>
    <div class="geo-value">3000 años</div>
    <div class="geo-desc">Historia andina</div>
  </div>
</div>

<!-- ========================
     INTRO
     ======================== -->
<section>
  <div id="intro">
    <div>
      <p class="section-label reveal">La Región</p>
      <h2 class="section-title reveal delay-1">Un mosaico de<br><em>paisajes y culturas</em></h2>
      <p class="section-body reveal delay-2">
        El Noroeste Argentino concentra una convergencia única: paisajes naturales de gran diversidad, una profunda herencia cultural andina, precolombina e hispánica, y una identidad popular viva que se expresa en tradiciones, gastronomía, música y artesanías.
      </p>
      <p class="section-body reveal delay-2" style="margin-top:1.2rem;">
        Desde las selvas húmedas de yungas en las laderas orientales de los Andes, pasando por valles templados con viñedos, hasta la imponente Puna que supera los 3.500 metros con salares, volcanes y lagunas de flamencos.
      </p>
      <div class="intro-stats">
        <div class="stat-box reveal delay-3">
          <div class="stat-number">+650.000</div>
          <div class="stat-label">Habitantes Salta Capital</div>
        </div>
        <div class="stat-box reveal delay-3">
          <div class="stat-number">+6.000</div>
          <div class="stat-label">Habitantes Tilcara</div>
        </div>
        <div class="stat-box reveal delay-4">
          <div class="stat-number">1.187m</div>
          <div class="stat-label">Altitud Salta Capital</div>
        </div>
        <div class="stat-box reveal delay-4">
          <div class="stat-number">2.465m</div>
          <div class="stat-label">Altitud Tilcara</div>
        </div>
      </div>
    </div>
    <div class="intro-img-wrap reveal-right">
      <img src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/quebrada.jpg" alt="Vista aérea de la Quebrada de Humahuaca, Patrimonio Mundial UNESCO, Jujuy Argentina" width="900" height="560" loading="lazy">
      <div class="intro-img-caption">Quebrada de Humahuaca — Patrimonio Mundial UNESCO</div>
    </div>
  </div>
</section>

<!-- ========================
     DESTINOS
     ======================== -->
<section id="destinos">
  <div class="destinos-header">
    <p class="section-label reveal" style="justify-content:center;">Centros Receptivos</p>
    <h2 class="section-title reveal delay-1">Dos destinos,<br><em>una sola experiencia</em></h2>
    <p class="section-body reveal delay-2" style="margin: 0 auto; text-align:center;">
      Salta Capital y Tilcara se complementan para ofrecer la experiencia completa del Norte argentino.
    </p>
  </div>
  <div class="destinos-grid">

    <!-- SALTA -->
    <div class="destino-card reveal-left">
      <img src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/salta.webp" alt="Salta Capital, casco histórico colonial, Argentina" width="900" height="600" loading="lazy">
      <div class="destino-card-body">
        <div class="destino-tag">Centro Receptivo Principal</div>
        <div class="destino-name">Salta<br>«La Linda»</div>
        <p class="destino-desc">Joya colonial con uno de los cascos históricos mejor conservados de Sudamérica. Base ideal para los Valles Calchaquíes, enoturismo en Cafayate y el Tren a las Nubes. Un destino dinámico para todo perfil de viajero.</p>
        <div class="destino-facts">
          <span class="destino-fact">1.187 m.s.n.m.</span>
          <span class="destino-fact">Prov. de Salta</span>
          <span class="destino-fact">+250 alojamientos</span>
          <span class="destino-fact">Cultural · Naturaleza · Enoturismo</span>
        </div>
        <a href="https://web-iat.vercel.app/#info" class="btn-outline">Descubrir Salta →</a>
      </div>
    </div>

    <!-- TILCARA -->
    <div class="destino-card reveal-right">
      <img src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/tilcara.webp" alt="Tilcara, Quebrada de Humahuaca, Jujuy Argentina — Patrimonio UNESCO" width="900" height="600" loading="lazy">
      <div class="destino-card-body">
        <div class="destino-tag">Patrimonio Mundial UNESCO</div>
        <div class="destino-name">Tilcara<br>Quebrada Sagrada</div>
        <p class="destino-desc">«Capital arqueológica» de Jujuy. En el corazón de la Quebrada de Humahuaca —Patrimonio Mundial UNESCO— con el Pucará de Tilcara, feria de artesanías y el Carnaval más auténtico de Argentina.</p>
        <div class="destino-facts">
          <span class="destino-fact">2.465 m.s.n.m.</span>
          <span class="destino-fact">Prov. de Jujuy</span>
          <span class="destino-fact">+80 alojamientos</span>
          <span class="destino-fact">Arqueológico · Vivencial · Aventura</span>
        </div>
        <a href="https://web-iat.vercel.app/#info" class="btn-outline">Descubrir Tilcara →</a>
      </div>
    </div>
  </div>
</section>

<!-- ========================
     ATRACTIVOS
     ======================== -->
<section id="atractivos">
  <div class="atractivos-inner">
    <div class="atractivos-header">
      <p class="section-label reveal">Atractivos de la Región</p>
      <h2 class="section-title reveal delay-1">Los grandes<br><em>escenarios del NOA</em></h2>
      <p class="section-body reveal delay-2">Seis maravillas que transformarán tu manera de ver Argentina.</p>
    </div>
    <div class="atractivos-grid">

      <!-- CERRO 7 COLORES — Featured -->
      <div class="atractivo-card featured reveal">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/7 colores.jpg" alt="Cerro 7 Colores Purmamarca" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Natural · Sagrado Andino</div>
          <div class="atractivo-name">Cerro de los Siete Colores</div>
          <p class="atractivo-desc">La imagen más icónica del NOA. Capas sedimentarias que exhiben rojo, ocre, amarillo, morado, verde, blanco y gris: el resultado de millones de años de historia geológica. Un espacio sagrado para las comunidades originarias. A sus pies, el pueblo colonial de Purmamarca con su mercado artesanal.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Purmamarca, Jujuy · 2.324 m.s.n.m.</span>
            <span class="atractivo-badge">Acceso libre</span>
          </div>
        </div>
      </div>

      <!-- PUCARA -->
      <div class="atractivo-card reveal delay-1">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/pucara.jpg" alt="Pucará de Tilcara" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Cultural · Arqueológico</div>
          <div class="atractivo-name">Pucará de Tilcara</div>
          <p class="atractivo-desc">Fortaleza prehispánica de los siglos XII–XV, con más de 8 hectáreas y 2.000 estructuras. Declarado Monumento Histórico Nacional. Vista panorámica de la Quebrada desde su cima.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Tilcara, Jujuy</span>
            <span class="atractivo-badge">$3.500–5.000 ARS</span>
          </div>
        </div>
      </div>

      <!-- SALINAS GRANDES -->
      <div class="atractivo-card reveal delay-2">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/grandes.jpg" alt="Salinas Grandes Argentina" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Natural · Salar de altura</div>
          <div class="atractivo-name">Salinas Grandes</div>
          <p class="atractivo-desc">212 km² de blancura absoluta a 3.450 m.s.n.m. Cuando llueve, el salar se convierte en un espejo perfecto del cielo. Flamencos rosados y vicuñas habitan sus bordes. Cielos nocturnos espectaculares.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Puna Jujeña-Salteña</span>
            <span class="atractivo-badge">$2.000–3.500 ARS</span>
          </div>
        </div>
      </div>

      <!-- QUEBRADA CAFAYATE -->
      <div class="atractivo-card reveal delay-1">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/Quebrada-de-Conchas.jpg" alt="Quebrada de Cafayate" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Natural · Geológico</div>
          <div class="atractivo-name">Quebrada de Cafayate</div>
          <p class="atractivo-desc">50 km de cañón escultural sobre la RN 68. El río modeló la roca roja durante millones de años creando formaciones únicas: El Anfiteatro, La Garganta del Diablo, Los Castillos. Al final: bodegas de Torrontés.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Sur de Salta, RN 68</span>
            <span class="atractivo-badge">Itinerario escénico</span>
          </div>
        </div>
      </div>

      <!-- CASCO HISTORICO -->
      <div class="atractivo-card reveal delay-2">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/centrosalta.jpg" alt="Casco histórico Salta" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Cultural · Colonial</div>
          <div class="atractivo-name">Centro Histórico de Salta</div>
          <p class="atractivo-desc">Plaza 9 de Julio, Catedral Basílica, Cabildo e Iglesia San Francisco (campanario de 53 m). El MAAM exhibe las momias incaicas del Llullaillaco: una de las colecciones arqueológicas más impactantes del mundo.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Salta Capital</span>
            <span class="atractivo-badge">Patrimonio Nacional</span>
          </div>
        </div>
      </div>

      <!-- TREN A LAS NUBES — Featured -->
      <div class="atractivo-card featured reveal">
        <img class="atractivo-img" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/tren.jpg" alt="Tren a las Nubes Salta" loading="lazy" width="900" height="300">
        <div class="atractivo-body">
          <div class="atractivo-type">Cultural · Ingeniería ferroviaria</div>
          <div class="atractivo-name">Tren a las Nubes</div>
          <p class="atractivo-desc">Uno de los recorridos ferroviarios más espectaculares del mundo. Asciende de 1.187 a 4.220 m.s.n.m. mediante 21 túneles, 13 viaductos y 29 puentes —sin cremallera— hasta el impresionante Viaducto La Polvorilla: 224 metros de metal flotando sobre la Puna. Monumento Histórico Nacional.</p>
          <div class="atractivo-meta">
            <span class="atractivo-loc">📍 Salta → Puna Salteña · 4.220 m.s.n.m.</span>
            <span class="atractivo-badge">$90.000–180.000 ARS</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

