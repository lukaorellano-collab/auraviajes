        <div class="form-success-icon">✦</div>
        <div class="form-success-text">¡Consulta enviada!</div>
        <p class="form-success-sub">Te respondemos en menos de 24 horas. ¡Gracias por elegirnos!</p>
      </div>
    </div>
  </div>
</section>

