      'mapa.p3.desc': 'Capital arqueológica de Jujuy. Pucará, cerros coloridos e o Carnaval mais autêntico da Argentina.',
      'mapa.p4.desc': 'Quebrada das Conchas, adegas de Torrontés e a Garganta do Diabo nos Vales Calchaquíes.',
      'mapa.caption': 'Salta · Tilcara · Cafayate · Quebrada de Humahuaca — Noroeste Argentino',
      'contacto.formtitle': 'Consulte disponibilidade',
      'contacto.formsub': 'Preencha o formulário e respondemos em menos de 24 horas.',
      'contacto.nombre': 'Nome completo', 'contacto.email': 'E-mail',
      'contacto.destino': 'Destino de interesse', 'contacto.personas': 'Número de pessoas',
      'contacto.desde': 'Data de chegada', 'contacto.hasta': 'Data de saída',
      'contacto.mensaje': 'Conte o que você procura na viagem',
      'contacto.submit': 'Enviar consulta →',
      'contacto.aviso': 'Ao enviar você aceita nossa Política de Privacidade. Não compartilhamos seus dados.',
      'contacto.whatsapp': '💬 Consultar no WhatsApp',
      'form.success.title': 'Consulta enviada!',
      'form.success.sub': 'Respondemos em menos de 24 horas. Obrigado por nos escolher!',
      'footer.copy': '© 2025 Descubra o Norte Argentino · Projeto acadêmico · NOA, Argentina',
      'page.lang': 'pt-BR',
      'page.title': 'Turismo em Salta e Tilcara 2025 — Descubra o Norte Argentino | NOA',
    }
  };

  let currentLang = 'es';

  function setLang(lang) {
    if (!translations[lang]) return;
    currentLang = lang;
    const t = translations[lang];

    // Update <html lang>
    document.documentElement.lang = t['page.lang'];
    document.title = t['page.title'];

    // Translate all [data-i18n] elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (t[key] !== undefined) el.innerHTML = t[key];
    });

    // Update nav links (no data-i18n, target by text content order)
    const navLinks = document.querySelectorAll('.nav-links li a');
    const navKeys = ['nav.destinos','nav.atractivos','nav.excursiones','nav.eventos','nav.planificar','nav.contacto'];
    navLinks.forEach((a, i) => { if (navKeys[i] && t[navKeys[i]]) a.textContent = t[navKeys[i]]; });

    // Update lang button label
    const flags = { es: '🇦🇷 ES', en: '🇺🇸 EN', pt: '🇧🇷 PT' };
    document.getElementById('lang-current-label').textContent = flags[lang];

    // Update active state on dropdown options
    document.querySelectorAll('.lang-option').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
    });
    document.querySelectorAll('.mobile-lang-btn').forEach(btn => {
      const bl = btn.textContent.includes('ES') ? 'es' : btn.textContent.includes('EN') ? 'en' : 'pt';
      btn.classList.toggle('active', bl === lang);
    });

    // Close dropdown
    const sw = document.getElementById('lang-switcher');
    sw.classList.remove('open');
    document.getElementById('lang-current-btn').setAttribute('aria-expanded', 'false');
  }

  /* ---- Lang dropdown toggle ---- */
  const langBtn = document.getElementById('lang-current-btn');
  const langSw = document.getElementById('lang-switcher');
  langBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = langSw.classList.toggle('open');
    langBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', () => {
    langSw.classList.remove('open');
    langBtn.setAttribute('aria-expanded', 'false');
  });
  langSw.addEventListener('click', e => e.stopPropagation());

  /* =============================
     MAP SWITCHER
     ============================= */
  const mapSrcs = {
    noa:      'https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d834507!2d-65.4!3d-24.1!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses!2sar!4v1700000000001',
    salta:    'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15552!2d-65.4117!3d-24.7859!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x941b6e1ceadcfcb1%3A0x7a2dc9aa18b955e5!2sSalta!5e0!3m2!1ses!2sar!4v1700000000002',
    tilcara:  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7760!2d-65.3967!3d-23.5777!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x941989ea6d6a9d1b%3A0x4b5c39d6c7be6e37!2sTilcara%2C%20Jujuy!5e0!3m2!1ses!2sar!4v1700000000003',
    cafayate: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15480!2d-65.9737!3d-26.0733!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9422dfbc4d50a12f%3A0x4d2421a24d2d71c2!2sCafayate%2C%20Salta!5e0!3m2!1ses!2sar!4v1700000000004'
  };

  function switchMap(key) {
    const frame = document.getElementById('gmap-frame');
    if (frame && mapSrcs[key]) frame.src = mapSrcs[key];
    document.querySelectorAll('.mapa-punto').forEach(el => el.classList.remove('active'));
    const pts = document.querySelectorAll('.mapa-punto');
    const idx = { noa: 0, salta: 1, tilcara: 2, cafayate: 3 };
    if (pts[idx[key]]) pts[idx[key]].classList.add('active');
  }

  /* -------- CURSOR -------- */
  const cursor = document.getElementById('cursor');
  const ring = document.getElementById('cursor-ring');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
  function animCursor() {
    cursor.style.left = mx + 'px'; cursor.style.top = my + 'px';
    rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
    ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
    requestAnimationFrame(animCursor);
  }
  animCursor();
  document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => {
      cursor.style.width = '20px'; cursor.style.height = '20px';
      ring.style.width = '50px'; ring.style.height = '50px';
    });
    el.addEventListener('mouseleave', () => {
      cursor.style.width = '12px'; cursor.style.height = '12px';
      ring.style.width = '36px'; ring.style.height = '36px';
    });
  });

  /* -------- NAV SCROLL -------- */
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 60);
  });

  /* -------- PROGRESS BAR -------- */
  const pbar = document.getElementById('progress-bar');
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const pct = (window.scrollY / (h.scrollHeight - h.clientHeight)) * 100;
    pbar.style.width = pct + '%';
  });

  /* -------- HERO PARALLAX -------- */
  const heroBg = document.getElementById('hero-bg');
  window.addEventListener('scroll', () => {
    if (window.scrollY < window.innerHeight) {
      heroBg.style.transform = `scale(1.08) translateY(${window.scrollY * 0.25}px)`;
    }
  });

  /* -------- REVEAL ON SCROLL -------- */
  const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => observer.observe(el));

  /* -------- MOBILE MENU -------- */
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileClose = document.getElementById('mobile-close');
  hamburger.addEventListener('click', () => {
    mobileMenu.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
  });
  mobileClose.addEventListener('click', () => {
    mobileMenu.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
  });
  document.querySelectorAll('.mobile-link').forEach(a => {
    a.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
    });
  });

  /* -------- CONTACT FORM -------- */
  function submitForm() {
    const nombre = document.getElementById('nombre').value.trim();
    const email = document.getElementById('email').value.trim();
    if (!nombre || !email) {
      alert(currentLang === 'en'
        ? 'Please fill in your name and email to continue.'
        : currentLang === 'pt'
        ? 'Por favor preencha seu nome e e-mail para continuar.'
        : 'Por favor completá tu nombre y email para continuar.');
      return;
    }
    document.getElementById('form-container').style.display = 'none';
    const succ = document.getElementById('form-success');
    succ.classList.add('show');
    const t = translations[currentLang];
    succ.querySelector('.form-success-text').textContent = t['form.success.title'];
    succ.querySelector('.form-success-sub').textContent = t['form.success.sub'];
  }

  /* -------- TOAST -------- */
  setTimeout(() => {
    const toast = document.getElementById('toast');
    toast.textContent = '✦ Scroll para descubrir el Norte Argentino';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3500);
  }, 4000);

  /* -------- SMOOTH ANCHOR -------- */
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const target = document.querySelector(a.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* -------- STAT NUMBER COUNTER -------- */
  function animateCount(el, target, suffix) {
    let start = 0; const dur = 1800;
    const step = (timestamp) => {
      if (!start) start = timestamp;
      const progress = Math.min((timestamp - start) / dur, 1);
      const val = Math.floor(progress * target);
      el.textContent = val.toLocaleString() + suffix;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target;
        const txt = el.textContent;
        if (txt.includes('650K')) animateCount(el, 650, 'K');
        if (txt.includes('7.500')) animateCount(el, 7500, '');
        statObserver.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.stat-number').forEach(el => statObserver.observe(el));

  /* -------- CARD TILT EFFECT -------- */
  document.querySelectorAll('.atractivo-card, .destino-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const r = card.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width - 0.5) * 8;
      const y = ((e.clientY - r.top) / r.height - 0.5) * -8;
      card.style.transform = `perspective(800px) rotateY(${x}deg) rotateX(${y}deg) translateY(-5px)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });
</script>


