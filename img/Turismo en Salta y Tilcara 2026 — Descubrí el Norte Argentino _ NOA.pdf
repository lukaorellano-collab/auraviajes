<section id="mapa" aria-label="Mapa de la región NOA">
  <div class="mapa-inner">
    <div class="mapa-header">
      <p class="section-label reveal" style="justify-content:center;" data-i18n="mapa.label">Ubicación &amp; Rutas</p>
      <h2 class="section-title reveal delay-1" data-i18n="mapa.title">Explorá el <em>territorio del NOA</em></h2>
      <p class="section-body reveal delay-2" style="margin:0 auto;text-align:center;" data-i18n="mapa.subtitle">Salta Capital, Tilcara y los principales atractivos de la región en un solo mapa.</p>
    </div>
    <div class="mapa-layout">
      <!-- Puntos de interés -->
      <div class="mapa-info-list reveal-left">
        <div class="mapa-punto active" onclick="switchMap(&#39;noa&#39;)">
          <div class="mapa-punto-nombre" data-i18n="mapa.p1.nombre">Región NOA</div>
          <p class="mapa-punto-desc" data-i18n="mapa.p1.desc">Vista general del Noroeste Argentino: Salta y Jujuy, provincias protagonistas del turismo andino.</p>
          <div class="mapa-punto-coords">Noroeste Argentina · 5 provincias</div>
        </div>
        <div class="mapa-punto" onclick="switchMap(&#39;salta&#39;)">
          <div class="mapa-punto-nombre">Salta Capital</div>
          <p class="mapa-punto-desc" data-i18n="mapa.p2.desc">Centro histórico, teleférico al Cerro San Bernardo y puerta de entrada a los Valles Calchaquíes.</p>
          <div class="mapa-punto-coords">24°47'S · 65°24'O · 1.187 m.s.n.m.</div>
        </div>
        <div class="mapa-punto" onclick="switchMap(&#39;tilcara&#39;)">
          <div class="mapa-punto-nombre">Tilcara, Quebrada</div>
          <p class="mapa-punto-desc" data-i18n="mapa.p3.desc">Capital arqueológica de Jujuy. Pucará, cerros de colores y el Carnaval más auténtico de Argentina.</p>
          <div class="mapa-punto-coords">23°34'S · 65°23'O · 2.461 m.s.n.m.</div>
        </div>
        <div class="mapa-punto" onclick="switchMap(&#39;cafayate&#39;)">
          <div class="mapa-punto-nombre">Cafayate</div>
          <p class="mapa-punto-desc" data-i18n="mapa.p4.desc">Quebrada de las Conchas, bodegas de Torrontés y la Garganta del Diablo en los Valles Calchaquíes.</p>
          <div class="mapa-punto-coords">26°04'S · 65°58'O · 1.683 m.s.n.m.</div>
        </div>
      </div>
      <!-- Mapa embed -->
      <div class="mapa-embed-wrap reveal-right">
        <iframe id="gmap-frame" src="./Turismo en Salta y Tilcara 2026 — Descubrí el Norte Argentino _ NOA_files/embed.html" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa del Noroeste Argentino — Salta y Tilcara" aria-label="Mapa interactivo de la región NOA: Salta, Tilcara y atractivos">
        </iframe>
        <div class="mapa-caption" data-i18n="mapa.caption">Salta · Tilcara · Cafayate · Quebrada de Humahuaca — Noroeste Argentino</div>
      </div>
    </div>
  </div>
</section>

